# ====================================
# APPLICATION
# ====================================
NODE_ENV=development
PORT=3012
API_PREFIX=/api/v1

# ====================================
# DATABASE (PostgreSQL)
# ====================================
DATABASE_URL="postgresql://egov_user:egov_password@localhost:5432/egov_db?schema=public"

# ====================================
# REDIS
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=egov_redis_password

# ====================================
# JWT AUTHENTICATION
# ====================================
JWT_ACCESS_SECRET=change_this_to_a_very_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====================================
# COOKIES
# ====================================
COOKIE_SECRET=change_this_to_a_random_cookie_secret
COOKIE_DOMAIN=localhost

# ====================================
# CORS
# ====================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ====================================
# FILE UPLOAD (Cloudinary)
# ====================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ====================================
# EMAIL (Nodemailer - Gmail)
# ====================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=E-Gov Portal
EMAIL_FROM_ADDRESS=noreply@egov-portal.com

# ====================================
# FRONTEND URL
# ====================================
FRONTEND_URL=http://localhost:5173

# ====================================
# LOGGING
# ====================================
LOG_LEVEL=debug
LOG_DIR=logs